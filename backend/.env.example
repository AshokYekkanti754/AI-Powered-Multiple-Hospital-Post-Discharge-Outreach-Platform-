# --- Database ---
# Production: postgresql://user:password@localhost:5432/outreach_platform
# Tests auto-override this with an in-memory SQLite DB; leave as-is for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach_platform

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

# ==========================================
# AI PROVIDERS
# ==========================================

# Primary provider
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# First fallback
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Second fallback
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.5-flash



# --- Voice / telephony (OPTIONAL — dummy values = simulated calls, fully working) ---
VOICE_PROVIDER=simulated
TWILIO_ACCOUNT_SID=AC-dummy-replace-me
TWILIO_AUTH_TOKEN=dummy-replace-me
TWILIO_PHONE_NUMBER=+10000000000
ELEVENLABS_API_KEY=eleven-dummy-replace-me
ELEVENLABS_VOICE_ID=dummy-voice-id
TELNYX_API_KEY=telnyx-dummy-replace-me

# --- Notifications (OPTIONAL) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dummy-replace-me
SMTP_PASSWORD=dummy-replace-me
SMS_PROVIDER_API_KEY=sms-dummy-replace-me

