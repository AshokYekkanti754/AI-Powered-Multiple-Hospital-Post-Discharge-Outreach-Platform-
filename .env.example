# ===========================================
# AI-Prof Environment Configuration
# Copy this file to .env and update values
# ===========================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/outreach_platform

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment
ENVIRONMENT=development

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# AI Provider (groq | openrouter | google | ollama | mock)
AI_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Voice Provider (simulated | twilio | elevenlabs | telnyx)
VOICE_PROVIDER=simulated
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id
TELNYX_API_KEY=your_telnyx_api_key

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dummy
SMTP_PASSWORD=dummy

# SMS
SMS_PROVIDER_API_KEY=your_sms_api_key
